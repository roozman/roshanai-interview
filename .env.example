DJANGO_SECRET_KEY=replace-with-a-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=roshanai
POSTGRES_USER=roshanai
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

DOCUMENT_MAX_UPLOAD_SIZE_BYTES=10485760
DOCUMENT_MAX_UNCOMPRESSED_SIZE_BYTES=52428800

DOCUMENT_CHUNK_SIZE_TOKENS=800
DOCUMENT_CHUNK_OVERLAP_TOKENS=120

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_EMBEDDING_BATCH_SIZE=16
OPENROUTER_TIMEOUT_SECONDS=60

RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.35
